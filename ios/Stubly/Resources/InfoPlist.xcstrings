    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds the trip's flights, hotel check-ins and check-outs and timed stops to the Stubly calendar in Calendar; adding again updates them."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Seyahatin uçuşlarını, otel giriş ve çıkışlarını ve saatli duraklarını Takvim'deki Stubly takvimine ekler; tekrar aktarınca günceller."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses the camera to photograph receipts and documents."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Harcama makbuzlarının ve belgelerin fotoğrafını çekmek için kamerayı kullanır."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reads your photo library to group photos from your trip dates into moments and show them on the map; photos never leave the device."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Seyahat tarihlerindeki fotoğraflarını anlara ayırıp haritada göstermek için fotoğraf arşivini okur; fotoğraflar cihazdan çıkmaz."
          }
        }
      }
    },
